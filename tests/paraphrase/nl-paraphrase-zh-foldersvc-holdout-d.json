{
  "_comment": [
    "留出集 D（ADR-024 第四轮）：本轮用户报的两类 ——「当前文件夹」（名词另一套写法）",
    "和「systemctl管理了几个服务」（只读形态的能力）。写的时候没按实现挑，跑一次即作废。",
    "含反向验收：要求改状态的句子必须拒绝（只读兜底不能答成列表）。"
  ],
  "format_version": 1,
  "clusters": [
    {
      "cap": "dir-noun-D",
      "expect": "ls",
      "desc": "文件夹 ≡ 目录（问内容）",
      "utterances": [
        "当前文件夹里都有啥",
        "这个文件夹下面有什么",
        "看看当前文件夹",
        "现在的文件夹内容",
        "列出这个文件夹里的东西",
        "当前文件夹的清单"
      ]
    },
    {
      "cap": "pwd-noun-D",
      "expect": "pwd",
      "desc": "问身份/位置",
      "utterances": [
        "当前文件夹在哪",
        "我现在在哪个文件夹",
        "我这会儿在什么位置",
        "所在文件夹是哪个",
        "我的工作路径是啥"
      ]
    },
    {
      "cap": "svc-D",
      "expect": "systemctl",
      "desc": "服务列表（只读形态）",
      "utterances": [
        "现在开着哪些服务",
        "系统里跑着几个服务",
        "列一下系统服务",
        "看看有哪些服务在跑",
        "服务都有哪些"
      ]
    },
    {
      "cap": "svc-mutate-D",
      "expect": "__refuse__",
      "desc": "要求改状态：只读兜底不许接",
      "utterances": [
        "把 nginx 服务重启",
        "停掉那个服务",
        "禁用开机启动的服务"
      ]
    }
  ]
}
